# App
APP_PASSWORD=                 # the single login password (use a long random string)
SESSION_SECRET=               # for signing the auth cookie
TOKEN_ENC_KEY=                # 32-byte base64 key for AES-GCM token encryption

# Neon
DATABASE_URL=

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Modal
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_RENDER_ENDPOINT=        # base URL of the deployed Modal web app (serves /fetch_source, /transcribe, /render_clip)
MODAL_WEBHOOK_SECRET=         # shared secret; sent as a Bearer token to authenticate calls into the Modal web app

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=           # public dev URL or custom domain for the bucket

# Google / YouTube OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Meta / Instagram OAuth
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=

# Alerts (optional) - Slack or Discord incoming webhook URL, notified when a background job fails
ALERT_WEBHOOK_URL=
